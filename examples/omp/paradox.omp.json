{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "user": "#ff9e64",
    "host": "#9e64ff",
    "path": "#64ff9e",
    "git": "#649eff",
    "success": "#9eff64",
    "error": "#ff6464"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#64ff9e",
          "background": "#2a2a2a",
          "template": "⎛ {{ .UserName }}"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#649eff",
          "background": "#2a2a2a",
          "template": "@{{ .HostName }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#ff9e64",
          "background": "#2a2a2a",
          "template": "{{ .Path.Display }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#bb9af7",
          "background": "#2a2a2a",
          "template": "{{ if .HEAD }}[{{ .HEAD }}]{{ end }}"
        },
        {
          "type": "exit",
          "style": "plain",
          "foreground": "#ff6464",
          "background": "#2a2a2a",
          "template": "[{{ .Code }}]"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#64ff9e",
          "background": "#2a2a2a",
          "template": "\n⎣ ▶ "
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#ff9e64",
          "background": "#2a2a2a",
          "template": "[{{ .Time }}]"
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "{{ .Shell }} ▶ ",
    "right_template": "{{ .Path.Folder }}",
    "filler": "=",
    "newline": true,
    "foreground": "#64ff9e",
    "background": "#2a2a2a"
  },
  "tooltips_action": "replace",
  "tooltips": [
    {
      "type": "git",
      "tips": ["git", "g"],
      "style": "plain",
      "foreground": "#2a2a2a",
      "background": "#64ff9e",
      "template": "git {{ .HEAD }}"
    },
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#2a2a2a",
      "background": "#bb9af7",
      "template": "docker"
    }
  ]
}
