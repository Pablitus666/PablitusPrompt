{
  "$schema": "https://pablitus.dev/schemas/theme.schema.json",
  "name": "Catppuccin",
  "version": "1.0",
  "source": "pablitus",
  "renderer": "powerline",
  "finalSpace": true,
  "defaultStyle": "powerline",
  "palette": {
    "text": "#cdd6f4",
    "darkText": "#1e1e2e",
    "sessionBg": "#cba6f7",
    "pathBg": "#585b70",
    "gitBg": "#fab387",
    "timeBg": "#89b4fa"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "session",
          "name": "session",
          "style": "powerline",
          "foreground": "darkText",
          "background": "sessionBg",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "path",
          "name": "path",
          "style": "powerline",
          "foreground": "text",
          "background": "pathBg",
          "template": "{{ .Path.Display }}"
        },
        {
          "type": "git",
          "name": "git",
          "style": "powerline",
          "foreground": "darkText",
          "background": "gitBg",
          "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}"
        },
        {
          "type": "time",
          "name": "time",
          "style": "diamond",
          "foreground": "darkText",
          "background": "timeBg",
          "template": "{{ .Time }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "exit",
          "name": "exit",
          "style": "plain",
          "foreground": "#f38ba8",
          "template": "{{ if ne .ExitCode 0 }}✘ {{ .ExitCode }} {{ end }}"
        },
        {
          "type": "text",
          "name": "prompt-symbol",
          "style": "plain",
          "foreground": "#b4befe",
          "template": "❯ "
        }
      ]
    }
  ]
}
