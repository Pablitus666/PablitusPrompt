{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .UserName }}@{{ .HostName }} ✦ ",
    "rightPrompt": "{{ .Path.Folder }}",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "{{ .Path.Folder }}",
    "filler": "•",
    "newline": true,
    "foreground": "#e0e0e0",
    "background": "#0f0c29"
  },
  "tooltipsAction": "replace",
  "tooltips": [
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#0f0c29",
      "background": "#bb86fc",
      "template": "git"
    },
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#0f0c29",
      "background": "#03dac6",
      "template": "docker"
    },
    {
      "type": "text",
      "tips": ["npm", "node"],
      "style": "plain",
      "foreground": "#0f0c29",
      "background": "#cf6679",
      "template": "node"
    }
  ],
  "theme": {
    "name": "Pablitus Nebula",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#0f0c29",
      "Foreground": "#e0e0e0",
      "Primary": "#bb86fc",
      "Secondary": "#03dac6",
      "Success": "#03dac6",
      "Warning": "#ff4081",
      "Error": "#cf6679",
      "SessionBg": "#bb86fc",
      "SessionFg": "#0f0c29",
      "PathBg": "#370028",
      "PathFg": "#e0e0e0",
      "GitBg": "#03dac6",
      "GitFg": "#0f0c29",
      "TimeBg": "#cf6679",
      "TimeFg": "#0f0c29",
      "Accent": "#03dac6",
      "Surface": "#1a173a"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "{{ .Path.Folder }}",
      "filler": "•",
      "newline": true
    },
    "tooltipsAction": "replace",
    "tooltips": [
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "diamond",
        "foreground": "#0f0c29",
        "background": "#bb86fc",
        "template": "git"
      },
      {
        "type": "text",
        "tips": ["docker", "d"],
        "style": "plain",
        "foreground": "#0f0c29",
        "background": "#03dac6",
        "template": "docker"
      },
      {
        "type": "text",
        "tips": ["npm", "node"],
        "style": "plain",
        "foreground": "#0f0c29",
        "background": "#cf6679",
        "template": "node"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "session",
            "name": "session",
            "style": "plain",
            "foreground": "#0f0c29",
            "background": "#bb86fc",
            "template": "{{ .UserName }}@{{ .HostName }}"
          },
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#e0e0e0",
            "background": "#370028",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "git",
            "name": "git",
            "style": "plain",
            "foreground": "#0f0c29",
            "background": "#03dac6",
            "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}",
            "timeoutMs": 1500
          },
          {
            "type": "time",
            "name": "time",
            "style": "plain",
            "foreground": "#0f0c29",
            "background": "#cf6679",
            "template": "{{ .Time }}"
          }
        ]
      },
      {
        "type": "rprompt",
        "alignment": "right",
        "filler": "•",
        "overflow": "hide",
        "segments": [
          {
            "type": "text",
            "template": "{{ .Path.Folder }}"
          }
        ]
      }
    ]
  }
}
