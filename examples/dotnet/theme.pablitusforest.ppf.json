{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .UserName }}@{{ .HostName }} 🌲 ❯ ",
    "rightPrompt": "{{ .Path.Folder }}",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "{{ .Path.Folder }}",
    "filler": ".",
    "newline": true,
    "foreground": "#d4edda",
    "background": "#1b2a1b"
  },
  "tooltipsAction": "extend",
  "tooltips": [
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#1b2a1b",
      "background": "#2e8b57",
      "template": "git"
    },
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#1b2a1b",
      "background": "#98fb98",
      "template": "docker"
    },
    {
      "type": "text",
      "tips": ["npm", "node"],
      "style": "plain",
      "foreground": "#d4edda",
      "background": "#8b4513",
      "template": "node"
    }
  ],
  "theme": {
    "name": "Pablitus Forest",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#1b2a1b",
      "Foreground": "#d4edda",
      "Primary": "#2e8b57",
      "Secondary": "#98fb98",
      "Success": "#2e8b57",
      "Warning": "#8b4513",
      "Error": "#8b4513",
      "SessionBg": "#2e8b57",
      "SessionFg": "#1b2a1b",
      "PathBg": "#98fb98",
      "PathFg": "#1b2a1b",
      "GitBg": "#2e8b57",
      "GitFg": "#1b2a1b",
      "TimeBg": "#98fb98",
      "TimeFg": "#1b2a1b",
      "Accent": "#2e8b57",
      "Surface": "#233a23"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "{{ .Path.Folder }}",
      "filler": ".",
      "newline": true
    },
    "tooltipsAction": "extend",
    "tooltips": [
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "diamond",
        "foreground": "#1b2a1b",
        "background": "#2e8b57",
        "template": "git"
      },
      {
        "type": "text",
        "tips": ["docker", "d"],
        "style": "plain",
        "foreground": "#1b2a1b",
        "background": "#98fb98",
        "template": "docker"
      },
      {
        "type": "text",
        "tips": ["npm", "node"],
        "style": "plain",
        "foreground": "#d4edda",
        "background": "#8b4513",
        "template": "node"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "session",
            "name": "session",
            "style": "plain",
            "foreground": "#1b2a1b",
            "background": "#2e8b57",
            "template": "{{ .UserName }}@{{ .HostName }}"
          },
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#1b2a1b",
            "background": "#98fb98",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "git",
            "name": "git",
            "style": "plain",
            "foreground": "#1b2a1b",
            "background": "#2e8b57",
            "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}",
            "timeoutMs": 1500
          },
          {
            "type": "time",
            "name": "time",
            "style": "plain",
            "foreground": "#1b2a1b",
            "background": "#98fb98",
            "template": "{{ .Time }}"
          }
        ]
      },
      {
        "type": "rprompt",
        "alignment": "right",
        "filler": ".",
        "overflow": "hide",
        "segments": [
          {
            "type": "text",
            "template": "{{ .Path.Folder }}"
          }
        ]
      }
    ]
  }
}
