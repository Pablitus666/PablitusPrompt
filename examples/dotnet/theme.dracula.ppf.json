{
  "$schema": "https://pablitus.dev/schemas/theme.schema.json",
  "name": "Dracula",
  "version": "1.0",
  "source": "pablitus",
  "renderer": "powerline",
  "finalSpace": true,
  "defaultStyle": "powerline",
  "palette": {
    "text": "#f8f8f2",
    "darkText": "#282a36",
    "sessionBg": "#44475a",
    "pathBg": "#6272a4",
    "gitBg": "#ffb86c",
    "timeBg": "#ff79c6"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "session",
          "name": "session",
          "style": "powerline",
          "foreground": "darkText",
          "background": "sessionBg",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "path",
          "name": "path",
          "style": "powerline",
          "foreground": "text",
          "background": "pathBg",
          "template": "{{ .Path.Display }}"
        },
        {
          "type": "git",
          "name": "git",
          "style": "powerline",
          "foreground": "darkText",
          "background": "gitBg",
          "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}"
        },
        {
          "type": "time",
          "name": "time",
          "style": "diamond",
          "foreground": "darkText",
          "background": "timeBg",
          "template": "{{ .Time }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "exit",
          "name": "exit",
          "style": "plain",
          "foreground": "#ff5555",
          "template": "{{ if ne .ExitCode 0 }}✘ {{ .ExitCode }} {{ end }}"
        },
        {
          "type": "text",
          "name": "prompt-symbol",
          "style": "plain",
          "foreground": "#8be9fd",
          "template": "❯ "
        }
      ]
    }
  ]
}
