{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .UserName }}@{{ .HostName }} ⚡ ❯ ",
    "rightPrompt": "{{ .Path.Folder }}",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "{{ .Path.Folder }}",
    "filler": ".",
    "newline": true,
    "foreground": "#ff00ff",
    "background": "#0a0a0f"
  },
  "tooltipsAction": "extend",
  "tooltips": [
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#0a0a0f",
      "background": "#00ffff",
      "template": "git"
    },
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#0a0a0f",
      "background": "#ff00ff",
      "template": "docker"
    },
    {
      "type": "text",
      "tips": ["npm", "node"],
      "style": "plain",
      "foreground": "#0a0a0f",
      "background": "#ffff00",
      "template": "node"
    }
  ],
  "theme": {
    "name": "Pablitus Cyberpunk",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#0a0a0f",
      "Foreground": "#ff00ff",
      "Primary": "#00ffff",
      "Secondary": "#ff00ff",
      "Success": "#00ffff",
      "Warning": "#ffff00",
      "Error": "#ff00ff",
      "SessionBg": "#00ffff",
      "SessionFg": "#0a0a0f",
      "PathBg": "#ff00ff",
      "PathFg": "#0a0a0f",
      "GitBg": "#ffff00",
      "GitFg": "#0a0a0f",
      "TimeBg": "#00ffff",
      "TimeFg": "#0a0a0f",
      "Accent": "#ff00ff",
      "Surface": "#12121a"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "{{ .Path.Folder }}",
      "filler": ".",
      "newline": true
    },
    "tooltipsAction": "extend",
    "tooltips": [
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "diamond",
        "foreground": "#0a0a0f",
        "background": "#00ffff",
        "template": "git"
      },
      {
        "type": "text",
        "tips": ["docker", "d"],
        "style": "plain",
        "foreground": "#0a0a0f",
        "background": "#ff00ff",
        "template": "docker"
      },
      {
        "type": "text",
        "tips": ["npm", "node"],
        "style": "plain",
        "foreground": "#0a0a0f",
        "background": "#ffff00",
        "template": "node"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "session",
            "name": "session",
            "style": "plain",
            "foreground": "#0a0a0f",
            "background": "#00ffff",
            "template": "{{ .UserName }}@{{ .HostName }}"
          },
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#0a0a0f",
            "background": "#ff00ff",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "git",
            "name": "git",
            "style": "plain",
            "foreground": "#0a0a0f",
            "background": "#ffff00",
            "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}",
            "timeoutMs": 1500
          },
          {
            "type": "time",
            "name": "time",
            "style": "plain",
            "foreground": "#0a0a0f",
            "background": "#00ffff",
            "template": "{{ .Time }}"
          }
        ]
      },
      {
        "type": "rprompt",
        "alignment": "right",
        "filler": ".",
        "overflow": "break",
        "segments": [
          {
            "type": "text",
            "template": "{{ .Path.Folder }}"
          }
        ]
      }
    ]
  }
}
