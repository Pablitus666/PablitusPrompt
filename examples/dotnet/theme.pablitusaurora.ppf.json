{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .UserName }}@{{ .HostName }} ➜ ",
    "rightPrompt": "{{ .Path.Folder }}",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "{{ .Path.Folder }}",
    "filler": "~",
    "newline": true,
    "foreground": "#cbd5e1",
    "background": "#0f172a"
  },
  "tooltipsAction": "replace",
  "tooltips": [
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#0f172a",
      "background": "#22d3ee",
      "template": "git"
    },
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#0f172a",
      "background": "#818cf8",
      "template": "docker"
    },
    {
      "type": "text",
      "tips": ["npm", "node"],
      "style": "plain",
      "foreground": "#0f172a",
      "background": "#4ade80",
      "template": "node"
    }
  ],
  "theme": {
    "name": "Pablitus Aurora",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#0f172a",
      "Foreground": "#cbd5e1",
      "Primary": "#22d3ee",
      "Secondary": "#818cf8",
      "Success": "#4ade80",
      "Warning": "#fbbf24",
      "Error": "#f87171",
      "SessionBg": "#22d3ee",
      "SessionFg": "#0f172a",
      "PathBg": "#1e1e4e",
      "PathFg": "#cbd5e1",
      "GitBg": "#818cf8",
      "GitFg": "#0f172a",
      "TimeBg": "#4ade80",
      "TimeFg": "#0f172a",
      "Accent": "#c084fc",
      "Surface": "#1e293b"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "{{ .Path.Folder }}",
      "filler": "~",
      "newline": true
    },
    "tooltipsAction": "replace",
    "tooltips": [
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "diamond",
        "foreground": "#0f172a",
        "background": "#22d3ee",
        "template": "git"
      },
      {
        "type": "text",
        "tips": ["docker", "d"],
        "style": "plain",
        "foreground": "#0f172a",
        "background": "#818cf8",
        "template": "docker"
      },
      {
        "type": "text",
        "tips": ["npm", "node"],
        "style": "plain",
        "foreground": "#0f172a",
        "background": "#4ade80",
        "template": "node"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "session",
            "name": "session",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#22d3ee",
            "template": "{{ .UserName }}@{{ .HostName }}"
          },
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#cbd5e1",
            "background": "#1e1e4e",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "git",
            "name": "git",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#818cf8",
            "template": "{{ if .Git.Branch }} {{ .Git.Branch }}{{ end }}",
            "timeoutMs": 1500
          },
          {
            "type": "time",
            "name": "time",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#4ade80",
            "template": "{{ .Time }}"
          }
        ]
      },
      {
        "type": "rprompt",
        "alignment": "right",
        "filler": "~",
        "overflow": "hide",
        "segments": [
          {
            "type": "text",
            "template": "{{ .Path.Folder }}"
          }
        ]
      }
    ]
  }
}
