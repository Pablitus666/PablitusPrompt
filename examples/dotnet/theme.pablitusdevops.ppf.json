{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .UserName }}@{{ .HostName }} {{ .Path.Display }} {{ if .Git.Branch }}[{{ .Git.Branch }}]{{ end }} docker k8s {{ .Time }} ➜ ",
    "rightPrompt": "",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "",
    "filler": "",
    "newline": true,
    "foreground": "#f8fafc",
    "background": "#0f172a"
  },
  "tooltipsAction": "replace",
  "tooltips": [
    {
      "type": "text",
      "tips": ["docker", "d"],
      "style": "plain",
      "foreground": "#0f172a",
      "background": "#0db9d7",
      "template": "docker"
    },
    {
      "type": "text",
      "tips": ["kubectl", "k"],
      "style": "plain",
      "foreground": "#0f172a",
      "background": "#326ce5",
      "template": "k8s"
    },
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "diamond",
      "foreground": "#0f172a",
      "background": "#ef4444",
      "template": "git"
    }
  ],
  "theme": {
    "name": "Pablitus DevOps",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#0f172a",
      "Foreground": "#f8fafc",
      "Primary": "#3b82f6",
      "Secondary": "#64748b",
      "Success": "#22c55e",
      "Warning": "#f59e0b",
      "Error": "#ef4444",
      "SessionBg": "#3b82f6",
      "SessionFg": "#0f172a",
      "PathBg": "#1e293b",
      "PathFg": "#cbd5e1",
      "GitBg": "#ef4444",
      "GitFg": "#f8fafc",
      "TimeBg": "#10b981",
      "TimeFg": "#0f172a",
      "Accent": "#f59e0b",
      "Surface": "#1e293b"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "",
      "filler": "",
      "newline": true
    },
    "tooltipsAction": "replace",
    "tooltips": [
      {
        "type": "text",
        "tips": ["docker", "d"],
        "style": "plain",
        "foreground": "#0f172a",
        "background": "#0db9d7",
        "template": "docker"
      },
      {
        "type": "text",
        "tips": ["kubectl", "k"],
        "style": "plain",
        "foreground": "#0f172a",
        "background": "#326ce5",
        "template": "k8s"
      },
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "diamond",
        "foreground": "#0f172a",
        "background": "#ef4444",
        "template": "git"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "session",
            "name": "session",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#3b82f6",
            "template": "{{ .UserName }}@{{ .HostName }}"
          },
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#cbd5e1",
            "background": "#1e293b",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "git",
            "name": "git",
            "style": "plain",
            "foreground": "#f8fafc",
            "background": "#ef4444",
            "template": "{{ if .Git.Branch }}[{{ .Git.Branch }}]{{ end }}"
          },
          {
            "type": "text",
            "name": "docker",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#0db9d7",
            "template": "docker"
          },
          {
            "type": "text",
            "name": "kubernetes",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#326ce5",
            "template": "k8s"
          },
          {
            "type": "time",
            "name": "time",
            "style": "plain",
            "foreground": "#0f172a",
            "background": "#10b981",
            "template": "{{ .Time }}"
          },
          {
            "type": "text",
            "name": "promptSymbol",
            "style": "plain",
            "foreground": "#f8fafc",
            "background": "#0f172a",
            "template": "➜"
          }
        ]
      }
    ]
  }
}
