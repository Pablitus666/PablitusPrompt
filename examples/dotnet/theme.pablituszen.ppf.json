{
  "$schema": "https://pablitus.dev/schemas/ppf.schema.json",
  "version": "1.0",
  "renderer": "plain",
  "finalSpace": true,
  "cache": {
    "enabled": true,
    "ttlSeconds": 30,
    "maxEntries": 256
  },
  "template": {
    "prompt": "{{ .Path.Display }} › ",
    "rightPrompt": "",
    "transientPrompt": "{{ .Shell }}> "
  },
  "transientPrompt": {
    "template": "{{ if .Interrupted }}^C {{ end }}{{ .Shell }}> ",
    "rightTemplate": "",
    "filler": "",
    "newline": true,
    "foreground": "#777777",
    "background": "#1a1a1a"
  },
  "tooltipsAction": "replace",
  "tooltips": [
    {
      "type": "text",
      "tips": ["git", "g"],
      "style": "plain",
      "foreground": "#1a1a1a",
      "background": "#777777",
      "template": "git"
    }
  ],
  "theme": {
    "name": "Pablitus Zen",
    "version": "1.0",
    "source": "pablitus",
    "renderer": "plain",
    "finalSpace": true,
    "palette": {
      "Background": "#1a1a1a",
      "Foreground": "#b0b0b0",
      "Primary": "#777777",
      "Secondary": "#444444",
      "Success": "#448844",
      "Warning": "#aaaa00",
      "Error": "#aa4444",
      "SessionBg": "#777777",
      "SessionFg": "#1a1a1a",
      "PathBg": "#333333",
      "PathFg": "#777777",
      "GitBg": "#448844",
      "GitFg": "#1a1a1a",
      "TimeBg": "#666666",
      "TimeFg": "#1a1a1a",
      "Accent": "#777777",
      "Surface": "#2a2a2a"
    },
    "template": {
      "transientPrompt": "{{ .Shell }}> ",
      "rightTemplate": "",
      "filler": "",
      "newline": true
    },
    "tooltipsAction": "replace",
    "tooltips": [
      {
        "type": "text",
        "tips": ["git", "g"],
        "style": "plain",
        "foreground": "#1a1a1a",
        "background": "#777777",
        "template": "git"
      }
    ],
    "blocks": [
      {
        "type": "prompt",
        "alignment": "left",
        "segments": [
          {
            "type": "path",
            "name": "path",
            "style": "plain",
            "foreground": "#777777",
            "background": "#1a1a1a",
            "template": "{{ .Path.Display }}"
          },
          {
            "type": "text",
            "name": "promptSymbol",
            "style": "plain",
            "foreground": "#777777",
            "background": "#1a1a1a",
            "template": "›"
          }
        ]
      }
    ]
  }
}
