<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PablitusPrompt</id>
    <title>Pablitus Prompt Framework</title>
    <version>1.5.0</version>
    <authors>Pablitus</authors>
    <owners>Pablitus</owners>
    <projectUrl>https://github.com/pablitus/pablitus-prompt</projectUrl>
    <repo type="git" url="https://github.com/pablitus/pablitus-prompt.git" />
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Pablitus Prompt Framework (PPF) - a declarative, extensible prompt platform for PowerShell 7+ with a .NET 8 core, Oh My Posh theme importer, PowerShell segment plugins, and JSON configuration.</description>
    <releaseNotes>
      v1.5.0 - Fast bootstrap, telemetry, .NET core adapter (opt-in), PowerShell plugin host, Phase 3B CI/parity/benchmarks, Phase 3C transient prompt / tooltips / right prompt.
    </releaseNotes>
    <tags>powershell prompt oh-my-posh pablitus prompt-framework transient right-prompt tooltips</tags>
    <dependencies>
      <dependency id="PSScriptAnalyzer" version="[1.25.0,)" />
    </dependencies>
    <frameworkAssemblies />
  </metadata>
  <files>
    <file src="src\**" target="PablitusPrompt\" />
    <file src="LICENSE" target="\" />
    <file src="README.md" target="\" />
    <file src="CHANGELOG.md" target="\" />
  </files>
</package>
