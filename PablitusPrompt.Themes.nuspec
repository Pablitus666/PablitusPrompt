<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PablitusPrompt.Themes</id>
    <title>Pablitus Prompt Framework - Temas adicionales</title>
    <version>1.5.0</version>
    <authors>Pablitus</authors>
    <owners>Pablitus</owners>
    <projectUrl>https://github.com/pablitus/pablitus-prompt</projectUrl>
    <repo type="git" url="https://github.com/pablitus/pablitus-prompt.git" />
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Temas adicionales para Pablitus Prompt Framework (PPF). Cada tema es un archivo .Theme.ps1 que se instala en la carpeta de temas del usuario mediante Install-PromptTheme y se registra con Import-PromptTheme.</description>
    <releaseNotes>
      v1.5.0 - Paquete inicial de temas adicionales desde PowerShell Gallery. Incluye Moonlight, Solarized y TokyoNight.
    </releaseNotes>
    <tags>powershell prompt pablitus themes oh-my-posh moonlight solarized tokyonight</tags>
    <dependencies>
      <dependency id="PablitusPrompt" version="[1.5.0,)" />
    </dependencies>
    <frameworkAssemblies />
  </metadata>
  <files>
    <file src="src\Themes\Moonlight.Theme.ps1" target="themes\" />
    <file src="src\Themes\Solarized.Theme.ps1" target="themes\" />
    <file src="src\Themes\TokyoNight.Theme.ps1" target="themes\" />
  </files>
</package>
